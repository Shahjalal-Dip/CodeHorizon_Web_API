@inject IToastService Toast
@inject NavigationManager Navigation

<ErrorBoundary @ref="_boundary">
    <ChildContent>
        @ChildContent
    </ChildContent>
    <ErrorContent Context="ex">
        <div class="alert alert-danger m-4" role="alert">
            <h2 class="h5">Something went wrong</h2>
            <p class="mb-3">@ex.Message</p>
            <div class="d-flex gap-2">
                <button class="btn btn-primary" @onclick="Recover">Try again</button>
                <a class="btn btn-outline-secondary" href="/">Go home</a>
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
    private ErrorBoundary? _boundary;

    private void Recover()
    {
        Toast.ShowInfo("Recovering from error...");
        _boundary?.Recover();
        Navigation.NavigateTo(Navigation.Uri, forceLoad: true);
    }
}
