<div class="avatar @SizeClass" role="img" aria-label="@AltText">
    @if (!string.IsNullOrWhiteSpace(ImageUrl))
    {
        <img src="@ImageUrl" alt="@AltText" loading="lazy" />
    }
    else
    {
        <span aria-hidden="true">@Initials</span>
    }
</div>

@code {
    [Parameter] public string? ImageUrl { get; set; }
    [Parameter] public string DisplayName { get; set; } = "User";
    [Parameter] public string Size { get; set; } = "md";

    private string AltText => $"{DisplayName} avatar";
    private string SizeClass => Size switch
    {
        "sm" => "avatar-sm",
        "lg" => "avatar-lg",
        _ => "avatar-md"
    };

    private string Initials
    {
        get
        {
            var parts = DisplayName.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (parts.Length >= 2)
                return $"{parts[0][0]}{parts[1][0]}".ToUpperInvariant();
            return parts.Length > 0 ? parts[0][..Math.Min(2, parts[0].Length)].ToUpperInvariant() : "?";
        }
    }
}
