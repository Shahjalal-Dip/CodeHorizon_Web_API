@page "/bookmarks"
@attribute [Authorize]
@inject IBookmarkService BookmarkApi
@inject IToastService Toast
@inject NavigationManager Navigation

<PageTitle>Bookmarks - Code Horizon</PageTitle>

<h1 class="h2 mb-4">My bookmarks</h1>

@if (_loading)
{
    <LoadingSpinner />
}
else if (!_bookmarks.Any())
{
    <div class="alert alert-info">You have no bookmarks yet. <a href="/browse">Browse snippets</a></div>
}
else
{
    <div class="list-group">
        @foreach (var bookmark in _bookmarks)
        {
            <div class="list-group-item d-flex justify-content-between align-items-center">
                <div>
                    <a href="/snippets/@bookmark.SnippetId" class="fw-semibold text-decoration-none">@bookmark.SnippetTitle</a>
                    <div class="small text-muted">by @bookmark.AuthorUsername · @bookmark.CreatedAt.ToString("g")</div>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <LanguageBadge Language="@bookmark.SnippetLanguage" />
                    <button class="btn btn-sm btn-outline-danger" @onclick="() => Remove(bookmark.SnippetId)">Remove</button>
                </div>
            </div>
        }
    </div>
    <Pagination CurrentPage="_page" TotalCount="_total" PageSize="10" OnPageChanged="ChangePage" />
}

@code {
    private List<BookmarkResponse> _bookmarks = [];
    private int _page = 1;
    private int _total;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await BookmarkApi.GetMyBookmarksAsync(_page, 10);
            _bookmarks = result.Data;
            _total = result.TotalCount;
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task Remove(Guid snippetId)
    {
        try
        {
            await BookmarkApi.RemoveAsync(snippetId);
            Toast.ShowInfo("Bookmark removed");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
    }
}
