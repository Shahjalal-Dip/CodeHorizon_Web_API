@page "/users/{Username}"
@inject IUserService Users
@inject ISnippetService Snippets
@inject IToastService Toast

<PageTitle>@Username - Code Horizon</PageTitle>

@if (_loading)
{
    <LoadingSpinner />
}
else if (_profile is null)
{
    <div class="alert alert-warning">User not found.</div>
}
else
{
    <section class="profile-header card mb-4">
        <div class="card-body d-flex flex-wrap gap-4 align-items-center">
            <AvatarComponent ImageUrl="@_profile.ProfilePictureUrl" DisplayName="@_profile.FullName" Size="lg" />
            <div>
                <h1 class="h3 mb-1">@_profile.FullName</h1>
                <p class="text-muted mb-2">@_profile.Username</p>
                @if (!string.IsNullOrWhiteSpace(_profile.Bio))
                {
                    <p>@_profile.Bio</p>
                }
                <div class="d-flex gap-4 small">
                    <span><strong>@_profile.SnippetsCount</strong> snippets</span>
                    <span><strong>@_profile.BookmarksCount</strong> bookmarks</span>
                    <span>Joined @_profile.CreatedAt.ToString("MMMM yyyy")</span>
                </div>
            </div>
        </div>
    </section>

    <h2 class="h5 mb-3">Public snippets</h2>
    @if (_snippets.Any())
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
            @foreach (var snippet in _snippets)
            {
                <div class="col"><SnippetCard Snippet="snippet" /></div>
            }
        </div>
        <Pagination CurrentPage="_page" TotalCount="_total" PageSize="12" OnPageChanged="LoadSnippets" />
    }
    else
    {
        <p class="text-muted">No public snippets yet.</p>
    }
}

@code {
    [Parameter] public string Username { get; set; } = string.Empty;

    private UserProfileResponse? _profile;
    private List<SnippetResponse> _snippets = [];
    private int _page = 1;
    private int _total;
    private bool _loading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _profile = await Users.GetByUsernameAsync(Username);
            if (_profile is not null)
                await LoadSnippets(1);
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadSnippets(int page)
    {
        _page = page;
        var result = await Snippets.GetPublicAsync(new SnippetFilter
        {
            Page = page,
            PageSize = 12,
            Search = Username
        });
        _snippets = result.Data.Where(s => s.AuthorUsername.Equals(Username, StringComparison.OrdinalIgnoreCase)).ToList();
        _total = _snippets.Count;
    }
}
