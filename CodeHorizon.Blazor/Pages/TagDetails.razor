@page "/tags/{Name}"
@inject ISnippetService Snippets
@inject IToastService Toast

<PageTitle>#@Name - Code Horizon</PageTitle>

<h1 class="h2 mb-1">Snippets tagged <span class="text-primary">#@Name</span></h1>
<p class="text-muted mb-4">@_totalCount results</p>

@if (_loading)
{
    <LoadingSpinner />
}
else
{
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var snippet in _snippets)
        {
            <div class="col"><SnippetCard Snippet="snippet" /></div>
        }
    </div>
    <Pagination CurrentPage="_page" TotalCount="_totalCount" PageSize="12" OnPageChanged="ChangePage" />
}

@code {
    [Parameter] public string Name { get; set; } = string.Empty;

    private List<SnippetResponse> _snippets = [];
    private int _page = 1;
    private int _totalCount;
    private bool _loading = true;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task ChangePage(int page)
    {
        _page = page;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            var result = await Snippets.GetPublicAsync(new SnippetFilter { Tag = Name, Page = _page, PageSize = 12 });
            _snippets = result.Data;
            _totalCount = result.TotalCount;
        }
        catch (ApiException ex)
        {
            Toast.ShowError(ex.Message);
        }
        finally
        {
            _loading = false;
        }
    }
}
