@using CodeHorizon.Blazor.Components.Auth
@inject NavigationManager Navigation
@inject IAnalyticsService Analytics
@implements IDisposable

<GlobalErrorBoundary>
    <CascadingAuthenticationState>
        <Router AppAssembly="@typeof(App).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        @if (context.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <Forbidden />
                        }
                    </NotAuthorized>
                    <Authorizing>
                        <LoadingSpinner Message="Checking authentication..." />
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
        </Router>
    </CascadingAuthenticationState>
</GlobalErrorBoundary>

<ToastContainer />

@code {
    protected override void OnInitialized()
    {
        Navigation.LocationChanged += OnLocationChanged;
        Analytics.TrackPageView(Navigation.ToBaseRelativePath(Navigation.Uri));
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Analytics.TrackPageView(Navigation.ToBaseRelativePath(e.Location));
    }

    public void Dispose() => Navigation.LocationChanged -= OnLocationChanged;
}
